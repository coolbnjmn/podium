#!/usr/bin/env bash
# Refuses any commit made while `main` or `development` is checked out.
# Branching before the first edit is a hard rule for every kind of work in
# this repo -- including informal fixes with no tracking issue -- per the
# git-branching skill. `development` is only ever the default branch in
# repos that use the development-branch workflow, but guarding it here is
# harmless elsewhere: a repo with no `development` branch never trips it.
# This hook is the technical backstop for that rule.
#
# Requires `git config core.hooksPath scripts/hooks` (one-time per clone,
# since .git/hooks isn't tracked) -- see the git-branching skill's setup steps.
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

if [[ "$branch" == "main" || "$branch" == "development" ]]; then
  cat >&2 <<EOF
REFUSED: commit blocked -- '$branch' is checked out.

main and development are shared state. All work here -- a tracked issue or
an informal fix with no tracking issue -- happens on a branch, created
before the first edit, and reaches '$branch' only through a PR:

  git checkout $branch && git pull
  git checkout -b <branch-name>

See the git-branching skill.
EOF
  exit 1
fi

exit 0
