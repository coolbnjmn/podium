# Generate an Admin API key in the Anthropic Console (org admin only) and paste it here as .env
ANTHROPIC_ADMIN_API_KEY=

# Server
PORT=4317
HOST=127.0.0.1

# Podium fleet console
# SQLite file (default: data/podium.sqlite in the repo)
PODIUM_DB=
# When set, POST /api/fleet/report, POST /api/fleet/hook and DELETE require the X-Podium-Token header
PODIUM_TOKEN=
STALE_AFTER_MS=15000
HOOK_STALE_AFTER_MS=600000
DROP_AFTER_MS=60000
LINGER_MS=8000
# Retention: chart samples 24 h, events 30 days, ended sessions 30 days
RETAIN_SAMPLES_MS=86400000
RETAIN_EVENTS_MS=2592000000
RETAIN_SESSIONS_MS=2592000000
